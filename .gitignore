# See https://help.github.com/articles/ignoring-files for more about ignoring files.

/.bundle

# Environment and secrets
/.env*
/config/master.key
/config/credentials/*.key

# Logs, temp files, local databases and uploads
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep
/db/*.sqlite3
/db/*.sqlite3-*

/public/assets
/node_modules
